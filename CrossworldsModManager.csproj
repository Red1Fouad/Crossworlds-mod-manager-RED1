<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
      <OutputType>WinExe</OutputType>
      <TargetFrameworks>net8.0;net8.0-windows</TargetFrameworks>
      <Nullable>enable</Nullable>
      <ApplicationIcon>Resources\icon.ico</ApplicationIcon>
      <AssemblyName>Bluestar Manager</AssemblyName>
      <Version>1.1.6</Version>
      <FileVersion>1.1.6.0</FileVersion>
      <AssemblyVersion>1.1.6.0</AssemblyVersion>
      <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)' == 'SelfContained'">
        <ConfigurationGroup>Release</ConfigurationGroup>
        <DefineConstants>SELFCONTAINED</DefineConstants>
        <SelfContained>true</SelfContained>
    </PropertyGroup>

    <PropertyGroup Condition="'$(TargetFramework)' == 'net8.0-windows'">
        <UseWindowsForms>true</UseWindowsForms>
    </PropertyGroup>

    <ItemGroup>
    <Content Include="Resources\icon.ico" />
  </ItemGroup>

  <ItemGroup>
    <!--
      tools\Locres and tools\LocresMod_Packed are generated at runtime (Save extracts the
      game's .locres files with CUE4Parse and repacks them), so they are never shipped.
      tools\UAssetAPI and tools\retoc are development-only and unreferenced by the app.
      Excluding Locres also keeps the copyrighted game .locres assets out of releases.
    -->
    <None Include="tools\**"
          Exclude="tools\UAssetAPI\**;tools\retoc\**;tools\Locres\**;tools\LocresMod_Packed\**"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="EnsureToolsDir" AfterTargets="Build">
    <MakeDir Directories="$(TargetDir)Tools" />
  </Target>

  <ItemGroup>
    <EmbeddedResource Include="Resources\question_mark.png" />
    <EmbeddedResource Include="Resources\blue_i.png" />
    <EmbeddedResource Include="Resources\yellow_exclamation_point.png" />
    <EmbeddedResource Include="Resources\red_x.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2210.55" />
    <PackageReference Include="NativeFileDialogs.Net" Version="1.3.0.1" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="SharpCompress" Version="0.48.1" />
    <PackageReference Include="CUE4Parse" Version="1.2.2" />
    <PackageReference Include="UAssetAPI" Version="1.1.0" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="Core.System.Windows.Forms" Version="1.0.0-alpha7" />
  </ItemGroup>

  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Updater\**" />
    <Compile Remove="tools\**" />
    <Compile Remove="test\**" />
  </ItemGroup>

</Project>
